# ============================================================================
#  Fiduce — variables d'environnement (exemple)
# ============================================================================
#  Ces valeurs sont des défauts de DÉVELOPPEMENT. En production, AUCUN secret ne
#  doit figurer dans un fichier versionné : ils sont injectés au runtime par le
#  gestionnaire de secrets de la plateforme (Vault, Sealed Secrets, SOPS, KMS…),
#  hors périmètre de ce dépôt applicatif.
# ============================================================================

# --- Dépendances ------------------------------------------------------------
DATABASE_URL=postgresql://fiduce:fiduce@postgres:5432/fiduce
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
NATS_STREAM=FIDUCE

# --- Observabilité ----------------------------------------------------------
# Endpoint OTLP/HTTP du collecteur de traces. Vide => pas d'export distant.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=INFO

# --- Authentification / JWT -------------------------------------------------
JWT_ISSUER=https://auth.fiduce.local
JWT_AUDIENCE=fiduce-api
JWT_ACCESS_TTL_S=3600
JWT_KEY_ID=fiduce-rsa-1
# Clé privée RSA (PEM) du service auth. EN PROD : injectée via un secret.
# En dev, si laissée vide, une clé éphémère est générée au démarrage.
# JWT_PRIVATE_KEY_PEM=

# --- Câblage de la gateway --------------------------------------------------
JWKS_URL=http://auth:8000/.well-known/jwks.json
AUTH_SERVICE_URL=http://auth:8000
LEDGER_SERVICE_URL=http://ledger:8000
REPORTING_SERVICE_URL=http://reporting:8000

# --- Données de démonstration ----------------------------------------------
# À DÉSACTIVER en production (DEMO_SEED=false). Le mot de passe de démo n'est PAS
# un secret de production : il n'amorce que des comptes de test.
DEMO_SEED=true
DEMO_PASSWORD=demo-password
